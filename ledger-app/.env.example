QUIKIT_AUTH_URL="http://localhost:3001"
# Must match the QuikIT cluster's INTERNAL_SECRET when enabled; never commit a real secret.
INTERNAL_SECRET=""
# Public launcher / OAuth IdP URL, reserved for future app-switcher/SSO integration.
QUIKIT_URL="http://localhost:3000"
