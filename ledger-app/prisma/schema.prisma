generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BalanceSide {
  DEBIT
  CREDIT
}

enum JournalSource {
  MANUAL
  INVOICE
  PAYMENT
  EXPENSE
  REVERSAL
  OPENING
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PAID
  VOID
}

model Account {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  type          AccountType
  normalBalance BalanceSide
  isActive      Boolean     @default(true)
  isSystem      Boolean     @default(false)
  lines         JournalLine[]
}

model JournalEntry {
  id           String        @id @default(cuid())
  entryNo      Int           @unique
  date         DateTime
  memo         String
  source       JournalSource
  sourceRef    String?
  reversalOfId String?       @unique
  prevHash     String
  hash         String
  createdBy    String
  createdAt    DateTime      @default(now())
  lines        JournalLine[]

  @@index([date])
  @@index([source])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  accountId   String
  debit       BigInt       @default(0)
  credit      BigInt       @default(0)
  description String?
  entry       JournalEntry @relation(fields: [entryId], references: [id])
  account     Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  customerName   String
  customerGstin  String?
  placeOfSupply  String
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus
  subtotal       BigInt
  cgst           BigInt
  sgst           BigInt
  igst           BigInt
  total          BigInt
  postingEntryId String?
  paymentEntryId String?
  voidEntryId    String?
  lines          InvoiceLine[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  qty         Decimal @db.Decimal(18, 4)
  unitPrice   BigInt
  gstRate     Decimal @db.Decimal(5, 2)
  amount      BigInt
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

model Expense {
  id                String   @id @default(cuid())
  date              DateTime
  vendor            String
  accountId         String
  amount            BigInt
  gstInput          BigInt
  paidFromAccountId String
  note              String?
  entryId           String
}

model Counter {
  name  String @id
  value Int
}
