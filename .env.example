# Finova (ledger-app) - dev port 3011. Variable names follow QuikIT docs/13-app-ports-and-env.md.
# Copy to .env.local (never commit real values). Cluster-wide secrets must match every QuikIT app.

# --- Data -------------------------------------------------------------------------------------
# mock = in-memory repositories (no DB needed); prisma = PostgreSQL.
DATA_SOURCE="mock"
# Standalone dev DB. Inside QuikIT this is the shared quikit_dev database (pooled URL in prod).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledger?schema=public"
# Direct (non-pooled) URL for migrations/DDL. In dev, same value as DATABASE_URL.
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/ledger?schema=public"

BUSINESS_STATE="Madhya Pradesh"
ENABLE_DEMO_ROUTES="false"
LOG_LEVEL="info"

# --- NextAuth (shared session) ------------------------------------------------------------------
# NEXTAUTH_SECRET MUST be identical across every app in the cluster (openssl rand -base64 32).
NEXTAUTH_SECRET=""
# Public origin of THIS app. Dev: http://localhost:3011. Prod: this app's own https://*.quikit.ai host.
NEXTAUTH_URL="http://localhost:3011"
APP_URL="http://localhost:3011"

# --- QuikIT integration (off by default so the app runs standalone) --------------------------------
QUIKIT_AUTH_ENABLED="false"
# Central credentials host. Dev: http://localhost:3001. Prod: https://authn.quikit.ai
NEXT_PUBLIC_AUTH_URL="http://localhost:3001"
# Base URL used for GET {url}/api/verify-token (defaults to NEXT_PUBLIC_AUTH_URL when unset).
QUIKIT_AUTH_URL="http://localhost:3001"
# Launcher / OAuth IdP. Dev: http://localhost:3000. Prod: https://apps.quikit.ai
QUIKIT_URL="http://localhost:3000"
NEXT_PUBLIC_QUIKIT_URL="http://localhost:3000"
# OAuth client credentials - real values are issued by the integration owner.
QUIKIT_CLIENT_ID="finova"
QUIKIT_CLIENT_SECRET=""
# Shared service-to-service secret (sent as x-internal-secret). MUST match every app in the cluster.
INTERNAL_SECRET=""

# --- Cache / rate limiting (optional in dev; required for multi-pod prod) -------------------------
REDIS_URL="redis://localhost:6379"
# Upstash REST deployments may use https://... with REDIS_TOKEN.
REDIS_TOKEN=""
# Optional natural-language search provider. Rules are always the default.
NL_SEARCH_LLM=false
NL_SEARCH_LLM_PROVIDER=
NL_SEARCH_LLM_API_KEY=
NL_SEARCH_LLM_TIMEOUT_MS=2500
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_QUIKIT_AUTH_ENABLED="false"

# --- Receipt scanning ---------------------------------------------------------------------------
# Browser-side Premium flag for the standalone scanner UI. In production derive this from entitlements.
NEXT_PUBLIC_FINOVA_PREMIUM="false"
FINOVA_PREMIUM="false"
# Optional provider-neutral email/WhatsApp gateway secret. Never expose this to the browser.
FINOVA_RECEIPT_INGEST_SECRET=""

# Finova AI Assistant: Brain #2 (Gemini fallback). Keys are used sequentially, never concurrently.
GEMINI_ENABLED=true
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=10000

# AI throttling
FINOVA_AI_RATE_LIMIT_MAX=8
FINOVA_AI_RATE_LIMIT_WINDOW_MS=60000
NEXT_PUBLIC_FINOVA_AI_RATE_LIMIT_MAX=8
NEXT_PUBLIC_FINOVA_AI_RATE_LIMIT_WINDOW_MS=60000
# Public support contact
NEXT_PUBLIC_SUPPORT_EMAIL=support@finova.example
